# PostgreSQL Configuration (Render dan olinadi)
POSTGRES_USER=ai_chatbot
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=ai_chatbot

# JWT Configuration (O'zingizni secret key yarating - minimum 32 belgi)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# Google Gemini AI API Key (Google AI Studio dan oling)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend API URL (Backend deploy qilingandan keyin yangilang)
VITE_API_URL=https://your-backend-domain.onrender.com/api

# CORS Origins (Frontend URL ni kiriting)
ALLOWED_ORIGINS=https://your-frontend-domain.onrender.com
